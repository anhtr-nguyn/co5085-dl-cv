@@ -31,9 +31,20 @@ class MSDeformAttnFunction(Function):
     @once_differentiable
     def backward(ctx, grad_output):
         value, value_spatial_shapes, value_level_start_index, sampling_locations, attention_weights = ctx.saved_tensors
-        grad_value, grad_sampling_loc, grad_attn_weight = \
-            MSDA.ms_deform_attn_backward(
-                value, value_spatial_shapes, value_level_start_index, sampling_locations, attention_weights, grad_output, ctx.im2col_step)
+        if torch.are_deterministic_algorithms_enabled():
+            # the CUDA backward accumulates with atomicAdd, whose order varies between runs;
+            # accumulating in fp64 then casting back makes the fp32 grads reproducible
+            dtypes = (value.dtype, sampling_locations.dtype, attention_weights.dtype)
+            grad_value, grad_sampling_loc, grad_attn_weight = \
+                MSDA.ms_deform_attn_backward(
+                    value.double(), value_spatial_shapes, value_level_start_index, sampling_locations.double(),
+                    attention_weights.double(), grad_output.double(), ctx.im2col_step)
+            grad_value, grad_sampling_loc, grad_attn_weight = \
+                grad_value.to(dtypes[0]), grad_sampling_loc.to(dtypes[1]), grad_attn_weight.to(dtypes[2])
+        else:
+            grad_value, grad_sampling_loc, grad_attn_weight = \
+                MSDA.ms_deform_attn_backward(
+                    value, value_spatial_shapes, value_level_start_index, sampling_locations, attention_weights, grad_output, ctx.im2col_step)
 
         return grad_value, None, None, grad_sampling_loc, grad_attn_weight, None
 
